# Sao chép file này thành .env rồi sửa giá trị cho máy của bạn
PORT=3000

# MySQL 8.0 chạy trên Laragon
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pickleball_booking

# Khóa ký phiên đăng nhập: BẮT BUỘC tự tạo, từ 32 ký tự. Server không chạy nếu để trống hoặc quá ngắn.
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Thời hạn phiên đăng nhập: token truy cập (phút), refresh token (ngày)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Khi triển khai thật: NODE_ENV=production (cookie Secure, ẩn token khỏi JSON), TRUST_PROXY=1 nếu đứng sau Nginx
NODE_ENV=development
TRUST_PROXY=0

# Giới hạn tần suất: API mỗi phút; đăng nhập sai và đăng ký trong 15 phút
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
AUTH_RATE_LIMIT=60

BCRYPT_ROUNDS=10

# Khóa ký mã QR check-in (mặc định suy ra từ JWT_SECRET)
QR_SECRET=

# Cổng thanh toán PayOS: để trống thì chạy chế độ giả lập (nút "Giả lập đã chuyển khoản"), đủ để chạy thử.
# Khóa thật lấy ở my.payos.vn, chỉ dán vào file .env trên máy mình, không gửi cho ai và không commit.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Địa chỉ frontend để PayOS chuyển khách về sau khi thanh toán
PAYOS_RETURN_URL=http://localhost:5173

# Khóa cho thiết bị IoT (ESP32 hoặc scripts/iot-simulator.js) gửi số đo cảm biến; để trống thì tắt API này
IOT_DEVICE_KEY=

# Số đo cảm biến tối đa mỗi phút, tính riêng với API_RATE_LIMIT
DEVICE_RATE_LIMIT=600

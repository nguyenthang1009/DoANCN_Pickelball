          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 và có Sân 04 đang bảo trì', () => { pm.response.to.have.status(200); const c = pm.response.json().courts.find(x => x.name.startsWith('Sân 04')); pm.expect(c.status).to.eql('MAINTENANCE'); });"
                ]
              }
            }
          ]
        },

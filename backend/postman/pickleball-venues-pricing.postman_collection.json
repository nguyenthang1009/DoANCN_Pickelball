    {
      "name": "3. Bảng giá động (price rules)",
      "item": [
        {
          "name": "Khách xem bảng giá Sân 01",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courts/1/price-rules",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('4 khung, giá mỗi ô bằng nửa giá giờ', () => { const rules = pm.response.json().rules; pm.expect(rules.length).to.eql(4); rules.forEach(x => pm.expect(x.pricePerSlot).to.eql(x.pricePerHour / 2)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Bảng giá hở khung 16:00–17:00",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/courts/1/price-rules",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rules\": [\n    {\n      \"dayType\": \"WEEKDAY\",\n      \"startTime\": \"06:00\",\n      \"endTime\": \"16:00\",\n      \"pricePerHour\": 120000\n    },\n    {\n      \"dayType\": \"WEEKDAY\",\n      \"startTime\": \"17:00\",\n      \"endTime\": \"22:00\",\n      \"pricePerHour\": 180000\n    },\n    {\n      \"dayType\": \"WEEKEND\",\n      \"startTime\": \"06:00\",\n      \"endTime\": \"17:00\",\n      \"pricePerHour\": 150000\n    },\n    {\n      \"dayType\": \"WEEKEND\",\n      \"startTime\": \"17:00\",\n      \"endTime\": \"22:00\",\n      \"pricePerHour\": 220000\n    }\n  ]\n}"

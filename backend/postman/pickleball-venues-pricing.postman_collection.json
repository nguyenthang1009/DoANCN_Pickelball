{
  "info": {
    "name": "Pickleball Booking – Tuần 5 Cơ sở, Sân & Bảng giá",
    "description": "Kiểm thử API cụm sân, sân con, bảng giá động, báo giá và danh mục dịch vụ. Nên chạy trên CSDL vừa khởi tạo bằng scripts/init-db.sh. Collection tạo thêm 1 cơ sở và 1 món dịch vụ (đã ngừng bán) mỗi lần chạy; bảng giá Sân 01 và trạng thái Sân 02 được trả về như cũ ở cuối mỗi nhóm.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "seedPassword",
      "value": "12345678"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.collectionVariables.get('suffix')) pm.collectionVariables.set('suffix', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Đăng nhập",
      "item": [
        {
          "name": "Admin đăng nhập",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"identifier\": \"admin@pickleball.vn\", \"password\": \"{{seedPassword}}\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager Q7 đăng nhập",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"identifier\": \"manager.q7@pickleball.vn\", \"password\": \"{{seedPassword}}\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('managerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff Q7 đăng nhập",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"identifier\": \"staff.q7@pickleball.vn\", \"password\": \"{{seedPassword}}\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('staffToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer đăng nhập",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"identifier\": \"customer1@gmail.com\", \"password\": \"{{seedPassword}}\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Cụm sân (venues)",
      "item": [
        {
          "name": "Khách xem danh sách cơ sở (công khai)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/venues",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 và có cơ sở Quận 7, Thủ Đức', () => { pm.response.to.have.status(200); const names = pm.response.json().venues.map(v => v.name); pm.expect(names).to.include('Cụm sân Pickleball Quận 7'); pm.expect(names).to.include('Cụm sân Pickleball Thủ Đức'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem chi tiết cơ sở 1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/venues/1",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Giờ mở cửa dạng HH:MM', () => { const v = pm.response.json().venue; pm.expect(v.openTime).to.eql('06:00'); pm.expect(v.closeTime).to.eql('22:00'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cơ sở không tồn tại",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/venues/999",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 VENUE_NOT_FOUND', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error.code).to.eql('VENUE_NOT_FOUND'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager không được tạo cơ sở",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/venues",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"address\": \"Y\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 FORBIDDEN', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Giờ mở cửa lệch 30 phút bị từ chối",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/venues",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cơ sở lỗi\",\n  \"address\": \"Q2\",\n  \"openTime\": \"06:15\",\n  \"closeTime\": \"22:00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 VALIDATION_ERROR', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin tạo cơ sở mới",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/venues",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Cụm sân Pickleball Quận 2 #{{suffix}}\", \"address\": \"12 Trần Não, TP. Thủ Đức\", \"openTime\": \"05:30\", \"closeTime\": \"23:00\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('Giờ mở cửa lưu đúng', () => pm.expect(pm.response.json().venue.openTime).to.eql('05:30'));",
                  "pm.collectionVariables.set('newVenueId', pm.response.json().venue.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rút giờ đóng cửa làm hở bảng giá",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/venues/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"closeTime\": \"21:00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 PRICE_RULES_MISMATCH', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().error.code).to.eql('PRICE_RULES_MISMATCH'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Sân con (courts)",
      "item": [
        {
          "name": "Khách xem sân của cơ sở 1",
